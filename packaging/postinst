#!/bin/sh
launchctl load @PREFIX@/Library/LaunchDaemons/com.lonsdaleite.chargelimit.plist 2>/dev/null
# iOS 15: restart accessoryd so it loads the helper.
if [ -f @PREFIX@/Library/MobileSubstrate/DynamicLibraries/ChargeLimitHelper.dylib ]; then
    launchctl kickstart -k system/com.apple.accessoryd 2>/dev/null
fi
exit 0
